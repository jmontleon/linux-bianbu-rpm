From 886d77409b4db3aee27c07a2780939cb3e55e14c Mon Sep 17 00:00:00 2001
From: wanlong <long.wan@spacemit.com>
Date: Thu, 25 May 2023 14:56:16 +0800
Subject: [PATCH 0053/1236] usb: dwc3: modify DMA capability

Change-Id: Ibea2f1e19752884356d1dd8dff1d2813225ecf8d
---
 drivers/usb/dwc3/core.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index eb10490a6d92c..01dd5d8ec076b 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -2249,6 +2249,11 @@ int dwc3_core_probe(const struct dwc3_probe_data *data)
 		ret = dma_set_mask_and_coherent(dwc->sysdev, DMA_BIT_MASK(64));
 		if (ret)
 			goto err_disable_clks;
+	} else if(!dwc->sysdev_is_parent &&
+		IS_ENABLED(CONFIG_SOC_SPACEMIT_K1PRO)) {
+		ret = dma_set_mask_and_coherent(dwc->sysdev, DMA_BIT_MASK(40));
+		if (ret)
+			goto disable_clks;
 	}
 
 	/*
