From 99a3cce78badb88ea6b284013acd04517e3615c1 Mon Sep 17 00:00:00 2001
From: Icenowy Zheng <uwu@icenowy.me>
Date: Fri, 21 Jun 2024 15:10:31 +0800
Subject: [PATCH 1101/1239] radeon/amdgpu: force 32-bit dma

Signed-off-by: Icenowy Zheng <uwu@icenowy.me>
---
 drivers/gpu/drm/radeon/radeon_device.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/radeon/radeon_device.c b/drivers/gpu/drm/radeon/radeon_device.c
index 9e35b14e2bf0e..dbc9524df4e25 100644
--- a/drivers/gpu/drm/radeon/radeon_device.c
+++ b/drivers/gpu/drm/radeon/radeon_device.c
@@ -1358,7 +1358,7 @@ int radeon_device_init(struct radeon_device *rdev,
 	 * AGP - generally dma32 is safest
 	 * PCI - dma32 for legacy pci gart, 40 bits on newer asics
 	 */
-	dma_bits = 40;
+	dma_bits = 32;
 	if (rdev->flags & RADEON_IS_AGP)
 		dma_bits = 32;
 	if ((rdev->flags & RADEON_IS_PCI) &&
-- 
