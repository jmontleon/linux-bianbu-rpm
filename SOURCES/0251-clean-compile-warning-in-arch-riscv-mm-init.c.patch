index d02f216ae768..0c0ee7c55b47 100644
--- a/arch/riscv/mm/init.c
+++ b/arch/riscv/mm/init.c
@@ -316,7 +316,7 @@ static void __init setup_bootmem(void)
 #ifdef CONFIG_ZONE_DMA32
