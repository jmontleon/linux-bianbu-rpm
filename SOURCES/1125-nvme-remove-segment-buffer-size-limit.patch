From 89dfa8bce88d961c763ddff478452c2fd41e8178 Mon Sep 17 00:00:00 2001
From: zhangmeng <zhangmeng.kevin@spacemit.com>
Date: Tue, 26 Nov 2024 10:39:12 +0800
Subject: [PATCH 1125/1205] nvme: remove segment buffer size limit

Change-Id: I826be53dd5999197b5f0405aa79953543472d82a
---
 drivers/nvme/host/core.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/drivers/nvme/host/core.c b/drivers/nvme/host/core.c
index 021f8f355b69..cc23035148b4 100644
--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -2201,9 +2201,6 @@ static int nvme_update_ns_info_block(struct nvme_ns *ns,
 	nvme_set_chunk_sectors(ns, id, &lim);
 	if (!nvme_update_disk_info(ns, id, &lim))
 		capacity = 0;
-#if defined(CONFIG_SOC_SPACEMIT_K1X)
-	blk_queue_max_segment_size(ns->disk->queue, 0x80000);
-#endif
 	nvme_config_discard(ns, &lim);
 	if (IS_ENABLED(CONFIG_BLK_DEV_ZONED) &&
 	    ns->head->ids.csi == NVME_CSI_ZNS)
-- 
2.49.0

