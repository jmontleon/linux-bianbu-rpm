From 788f26ff2d45e223a019416c86cf55ecea383f96 Mon Sep 17 00:00:00 2001
From: lijuan <juan.li@spacemit.com>
Date: Mon, 14 Oct 2024 18:10:42 +0800
Subject: [PATCH 1038/1236] blk: add request completion flags for debug

Change-Id: Ib84003e68d537173a9d550071d43eab587d10fb6
---
 block/blk-mq.c         | 2 ++
 include/linux/blk-mq.h | 1 +
 2 files changed, 3 insertions(+)

diff --git a/block/blk-mq.c b/block/blk-mq.c
index a03f52ab87d6..e43f232fa5b5 100644
--- a/block/blk-mq.c
+++ b/block/blk-mq.c
@@ -1286,6 +1286,7 @@ static void blk_mq_complete_send_ipi(struct request *rq)
 	cpu = rq->mq_ctx->cpu;
 	if (llist_add(&rq->ipi_list, &per_cpu(blk_cpu_done, cpu)))
 		smp_call_function_single_async(cpu, &per_cpu(blk_cpu_csd, cpu));
+	WRITE_ONCE(rq->request_debug_flags, 1);
 }
 
 static void blk_mq_raise_softirq(struct request *rq)
@@ -3569,6 +3570,7 @@ static int blk_mq_init_request(struct blk_mq_tag_set *set, struct request *rq,
 	}
 
 	WRITE_ONCE(rq->state, MQ_RQ_IDLE);
+	WRITE_ONCE(rq->request_debug_flags, 0);
 	return 0;
 }
 
diff --git a/include/linux/blk-mq.h b/include/linux/blk-mq.h
index b25d12545f46..6566cda8f402 100644
--- a/include/linux/blk-mq.h
+++ b/include/linux/blk-mq.h
@@ -206,6 +206,7 @@ struct request {
 	 */
 	rq_end_io_fn *end_io;
 	void *end_io_data;
+	int request_debug_flags;
 };
 
 static inline enum req_op req_op(const struct request *req)
-- 
2.53.0

