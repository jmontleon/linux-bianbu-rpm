From 4af2086a8d571b7095c7ee516390d2458c90b860 Mon Sep 17 00:00:00 2001
From: wanlong <long.wan@spacemit.com>
Date: Mon, 7 Aug 2023 10:53:20 +0800
Subject: [PATCH 0102/1235] usb: dwc2: modify gadget DMA capability

Change-Id: If706005ff99e655420bf8f0d9db008bd2ad1d55c
---
 drivers/usb/dwc2/platform.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/usb/dwc2/platform.c b/drivers/usb/dwc2/platform.c
index dd8661d8bc3c6..544f96c5684a9 100644
--- a/drivers/usb/dwc2/platform.c
+++ b/drivers/usb/dwc2/platform.c
@@ -453,7 +453,7 @@ static int dwc2_driver_probe(struct platform_device *dev)
 	 */
 	if (!dev->dev.dma_mask)
 		dev->dev.dma_mask = &dev->dev.coherent_dma_mask;
-	retval = dma_set_coherent_mask(&dev->dev, DMA_BIT_MASK(40));
+	retval = dma_set_mask_and_coherent(&dev->dev, DMA_BIT_MASK(40));
 	if (retval) {
 		dev_err(&dev->dev, "can't set coherent DMA mask: %d\n", retval);
 		return retval;
-- 
2.53.0

