From: zhangmeng <zhangmeng.kevin@spacemit.com>
Date: Tue, 26 Nov 2024 10:42:18 +0800
Subject: [PATCH 1152/1239] flexcan: fix error in flexcan-core probe function

Change-Id: I67dd402e04561b2baf3c7ec3b5bcd0d0d89d47b4
---
 drivers/net/can/flexcan/flexcan-core.c | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/drivers/net/can/flexcan/flexcan-core.c b/drivers/net/can/flexcan/flexcan-core.c
index e7e774bbb0cf..07e1c7cf23cf 100644
--- a/drivers/net/can/flexcan/flexcan-core.c
+++ b/drivers/net/can/flexcan/flexcan-core.c
@@ -2289,15 +2289,10 @@ static int flexcan_probe(struct platform_device *pdev)
 #ifdef CONFIG_SOC_SPACEMIT_K1X
 	if (!of_get_property(pdev->dev.of_node, "rcpu-can", NULL)) {
 		irq = platform_get_irq(pdev, 0);
-		if (irq <= 0)
-			return -ENODEV;
+		if (irq < 0)
+			return irq;
 	} else {
 		irq = -1;
-		of_id = of_match_device(r_flexcan_of_match, &pdev->dev);
-		if (of_id)
-			devtype_data = of_id->data;
-		else
-			return -ENODEV;
 	}
 #else
  	irq = platform_get_irq(pdev, 0);
